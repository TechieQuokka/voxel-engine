{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },

    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "-O0 -g, assertions on",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MC_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "asan",
      "inherits": "debug",
      "displayName": "Debug + AddressSanitizer",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },

    {
      "name": "tsan",
      "inherits": "debug",
      "displayName": "Debug + ThreadSanitizer",
      "description": "The only way to check the lock-free queue's memory ordering; a passing test tells you nothing on its own",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },

    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "-O3 with LTO, assertions off",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_AR": "/usr/bin/gcc-ar",
        "CMAKE_RANLIB": "/usr/bin/gcc-ranlib",
        "CMAKE_NM": "/usr/bin/gcc-nm",
        "MC_BUILD_TESTS": "OFF"
      }
    },

    {
      "name": "release-tracy",
      "inherits": "release",
      "displayName": "Release + Tracy",
      "description": "Release build with Tracy profiler instrumentation",
      "cacheVariables": {
        "MC_ENABLE_TRACY": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "debug",         "configurePreset": "debug",         "jobs": 0 },
    { "name": "asan",          "configurePreset": "asan",          "jobs": 0 },
    { "name": "tsan",          "configurePreset": "tsan",          "jobs": 0 },
    { "name": "release",       "configurePreset": "release",       "jobs": 0 },
    { "name": "release-tracy", "configurePreset": "release-tracy", "jobs": 0 }
  ],

  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "description": "393 cases, one ctest entry each. jobs is a fixed 8 because a test preset has no way to say 'all cores' -- 0 means serial here, unlike a build preset. Oversubscribing a smaller machine costs nothing at this case length; override with -j to be exact.",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "description": "Serial on purpose: ThreadSanitizer's shadow memory is several times the heap, and eight of these at once is how a machine starts swapping.",
      "output": { "outputOnFailure": true }
    }
  ]
}
